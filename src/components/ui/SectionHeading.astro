---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  light?: boolean;
  class?: string;
}

const { eyebrow, light = false, class: className }: Props = Astro.props;
---

<div class:list={['max-w-head', className]}>
  {eyebrow && <Eyebrow light={light}>{eyebrow}</Eyebrow>}
  <h2>
    <slot />
  </h2>
  <slot name="lead" />
</div>
