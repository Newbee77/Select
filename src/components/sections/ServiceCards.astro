---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';

interface ServiceCard {
  number: string;
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  cards: ServiceCard[];
  ctaLabel: string;
  ctaHref: string;
}

const { eyebrow, heading, lead, cards, ctaLabel, ctaHref }: Props = Astro.props;
---

<section class="bg-ink-950 py-24 md:py-32 lg:py-40">
  <Container>
    <Reveal>
      <SectionHeading eyebrow={eyebrow}>
        {heading}
        <Fragment slot="lead">
          <p class="mt-5 max-w-lead text-lead text-ink-300">{lead}</p>
        </Fragment>
      </SectionHeading>
    </Reveal>

    <div class="mt-16 grid gap-6 md:grid-cols-3 md:gap-8">
      {
        cards.map((card) => (
          <Reveal>
            <Card>
              <Fragment slot="number">{card.number}</Fragment>
              <h3 class="mb-3">{card.title}</h3>
              <p class="text-small text-ink-300">{card.body}</p>
            </Card>
          </Reveal>
        ))
      }
    </div>

    <div class="mt-12">
      <Button href={ctaHref} variant="link">
        {ctaLabel}
      </Button>
    </div>
  </Container>
</section>
