---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';

interface Props {
  eyebrow: string;
  heading: string;
  reverse?: boolean;
  light?: boolean;
  image: ImageMetadata;
  ctaLabel: string;
  ctaHref: string;
}

const {
  eyebrow,
  heading,
  reverse = false,
  light = false,
  image,
  ctaLabel,
  ctaHref,
}: Props = Astro.props;

const sectionBg = light ? 'bg-paper' : 'bg-ink-950';
const sectionText = light ? 'text-ink-950' : '';
const imageBorder = light ? 'border-ink-100' : 'border-ink-700';
---

<section class:list={[sectionBg, sectionText, 'py-24 md:py-32 lg:py-40']}>
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <Reveal class:list={reverse ? 'lg:order-2' : ''}>
        <SectionHeading eyebrow={eyebrow} light={light}>
          {heading}
        </SectionHeading>
        <div class="mt-6">
          <slot />
        </div>
        <slot name="ticks" />
        <div class="mt-9">
          <Button href={ctaHref} variant="link" light={light}>
            {ctaLabel}
          </Button>
        </div>
      </Reveal>

      <Reveal class:list={reverse ? 'lg:order-1' : ''}>
        <Picture
          src={image}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          alt=""
          width={1200}
          height={Math.round((1200 / image.width) * image.height)}
          quality={60}
          loading="lazy"
          decoding="async"
          class:list={['aspect-[4/3] w-full rounded-card border object-cover', imageBorder]}
        />
      </Reveal>
    </div>
  </Container>
</section>
