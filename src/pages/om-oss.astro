---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { sv } from '../i18n/sv';
---

<BaseLayout title={sv.meta.about.title} description={sv.meta.about.description}>
  <section class="bg-ink-950 py-24 md:py-32 lg:py-40">
    <Container>
      <h1>{sv.pages.about.h1}</h1>
    </Container>
  </section>
</BaseLayout>
