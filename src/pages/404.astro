---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { sv } from '../i18n/sv';

const notFound = sv.pages.notFound;
---

<BaseLayout title={sv.meta.notFound.title} description={sv.meta.notFound.description} noindex>
  <section class="flex min-h-[70vh] items-center bg-ink-950 py-24 md:py-32">
    <Container class="text-center">
      <p class="text-eyebrow uppercase text-amber-500">404</p>
      <h1 class="mt-4">{notFound.h1}</h1>
      <p class="mx-auto mt-6 max-w-lead text-lead text-ink-300">{notFound.body}</p>
      <Button href="/" class="mt-10">{notFound.backHome}</Button>
    </Container>
  </section>
</BaseLayout>
