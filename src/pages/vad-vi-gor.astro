---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import SkillGroups from '../components/sections/SkillGroups.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { sv } from '../i18n/sv';

const services = sv.services;
---

<BaseLayout title={sv.meta.whatWeDo.title} description={sv.meta.whatWeDo.description}>
  <PageHero
    eyebrow={services.hero.eyebrow}
    heading={services.hero.heading}
    lead={services.hero.lead}
  />

  <ProcessSteps steps={services.process.steps} />

  <SkillGroups
    eyebrow={services.skills.eyebrow}
    heading={services.skills.heading}
    groups={services.skills.groups}
    note={services.skills.note}
  />

  <CtaBand
    heading={services.ctaBand.heading}
    text={services.ctaBand.text}
    ctaLabel={services.ctaBand.cta}
    ctaHref="/kontakt"
  />
</BaseLayout>
