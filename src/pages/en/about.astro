---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ValueList from '../../components/sections/ValueList.astro';
import TeamGrid from '../../components/sections/TeamGrid.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Container from '../../components/ui/Container.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { en } from '../../i18n/en';

const about = en.about;
---

<BaseLayout title={en.meta.about.title} description={en.meta.about.description}>
  <PageHero eyebrow={about.hero.eyebrow} heading={about.hero.heading} lead={about.hero.lead} />

  <section class="bg-ink-950 py-24 md:py-32 lg:py-40">
    <Container>
      <Reveal class="max-w-narrow">
        {
          about.story.paragraphs.map((paragraph) => (
            <p class="mt-4 max-w-prose text-body text-ink-300 first:mt-0">{paragraph}</p>
          ))
        }
      </Reveal>
    </Container>
  </section>

  <ValueList values={about.values.items} />

  <TeamGrid members={about.team.members} />

  <CtaBand
    heading={en.home.ctaBand.heading}
    text={en.home.ctaBand.text}
    ctaLabel={en.home.ctaBand.cta}
    ctaHref="/en/contact"
  />
</BaseLayout>
